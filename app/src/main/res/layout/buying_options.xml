<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_layout">

    <Button
        android:id="@+id/ChangeP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_weight="1"
        android:inputType=""
        android:backgroundTint="#301919"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/ChangePrice"
        android:textAllCaps="false"
        android:textSize="14dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/total_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.517"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/price_layout"
        app:layout_constraintVertical_bias="1.0" />

    <ImageButton
        android:id="@+id/minus2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:contentDescription="@string/decriment"
        android:minHeight="48dp"


        android:src="@drawable/minus"
        app:layout_constraintBottom_toBottomOf="@+id/Quantity"
        app:layout_constraintEnd_toStartOf="@+id/Quantity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/product_price"
        app:layout_constraintVertical_bias="0.605" />

    <EditText
        android:id="@+id/Quantity"
        android:layout_width="0dp"

        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/rounded_edit_text_layout"
        android:fontFamily="@font/nunito_bold"
        android:hint="@string/Quantity"
        android:minHeight="48dp"
        android:textAlignment="center"
        app:layout_constraintEnd_toStartOf="@+id/plus2"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/minus2"
        app:layout_constraintTop_toBottomOf="@+id/total_layout" />

    <ImageButton
        android:id="@+id/plus2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"

        android:contentDescription="@string/decriment"
        android:minHeight="48dp"
        android:src="@drawable/plus"
        app:layout_constraintBottom_toBottomOf="@+id/Quantity"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/Quantity"
        app:layout_constraintTop_toBottomOf="@+id/product_price" />

    <TextView
        android:id="@+id/Product_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/Product_name"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.542"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:id="@+id/price_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/Product_name"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/dzd3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/Price"
            android:textColor="#000000"
            android:layout_weight="1"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/product_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/Product_name"
            app:layout_constraintVertical_bias="0.839" />
        <EditText
            android:id="@+id/product_price_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_edit_text_layout"
            android:fontFamily="@font/nunito_bold"
            android:minHeight="48dp"
            android:text=" 0.00 "
            android:inputType="numberDecimal"

            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="@integer/material_motion_duration_long_1"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"
/>
        <TextView
            android:id="@+id/dzd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="40dp"
            android:fontFamily="@font/nunito_bold"
            android:text="DZD"
            android:textColor="#000000"
            android:textSize="24sp"

android:layout_weight="1"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/product_price"
            app:layout_constraintEnd_toEndOf="@+id/Quantity"
            app:layout_constraintTop_toBottomOf="@+id/Product_name"
            app:layout_constraintVertical_bias="0.839" />



    </LinearLayout>


  <LinearLayout
      android:id="@+id/total_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:layout_marginTop="10dp"
      app:layout_constraintTop_toBottomOf="@+id/ChangeP"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <TextView
          android:id="@+id/dzd4"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/nunito_bold"
          android:text="@string/Total"
          android:layout_marginStart="48dp"
          android:layout_marginTop="10dp"

          android:textColor="#000000"
android:layout_weight="1"
          android:textSize="24sp"
          android:textStyle="bold"
          app:layout_constraintBottom_toBottomOf="@+id/product_price2"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/dzd3"
          app:layout_constraintVertical_bias="0.804" />




      <TextView
          android:id="@+id/total_price"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/nunito_bold"
          android:layout_marginTop="10dp"
          android:minHeight="48dp"
          android:layout_marginStart="10dp"
          android:layout_marginEnd="10dp"
          android:text=" 0.00 "
          android:layout_weight="@integer/material_motion_duration_long_1"
          android:textAlignment="center"
          android:textColor="#000000"
          android:textSize="24sp"
          android:textStyle="bold"
 />

      <TextView
          android:id="@+id/dzd2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/nunito_bold"
          android:text="DZD"
          android:textColor="#000000"
          android:textSize="24sp"
        android:layout_weight="1"
          android:layout_marginTop="10dp"

          android:layout_marginEnd="40dp"

          android:textStyle="bold"
 />
  </LinearLayout>


    <LinearLayout
        android:id="@+id/Buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Quantity">

        <Button
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:layout_weight="1"

            android:backgroundTint="@color/purple_500"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/cancel"
            android:textAllCaps="false"

            />

        <Button
            android:id="@+id/Ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="20dp"
            android:layout_weight="1"
            android:backgroundTint="#301919"

            android:fontFamily="@font/nunito_bold"
            android:text="@string/Ok"
            android:textAllCaps="false" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>