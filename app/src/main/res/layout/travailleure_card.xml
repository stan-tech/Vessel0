<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="5dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="15dp"

    android:background="@drawable/rounded_layout" >

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/trav_card">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/Call"
            android:src="@drawable/pfp"

            app:civ_border_width="0.2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/Nametv"
            app:layout_constraintHorizontal_bias="0.387"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageButton
            android:id="@+id/call_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"

            android:background="@drawable/transparent_backround"
            android:contentDescription="@string/Call"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:rotation="270"
            android:src="@drawable/phone_enabled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.955"
            app:layout_constraintStart_toEndOf="@id/textView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.487" />

        <TextView
            android:id="@+id/Nametv"
            android:layout_width="wrap_content"

            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/nunito_bold"
            android:text="Name.............."
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.254"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/profile_image"
            app:layout_constraintVertical_bias="0.142" />

        <TextView
            android:id="@+id/Phonetv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:text="055555555555"

            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="@+id/profile_image"
            app:layout_constraintStart_toStartOf="@+id/Nametv"
            app:layout_constraintTop_toBottomOf="@+id/Nametv" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Closeness"
            android:fontFamily="@font/nunito_bold"

            android:layout_marginEnd="10dp"
            android:layout_marginStart="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.701"
            app:layout_constraintStart_toEndOf="@+id/Phonetv"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.506"
            app:layout_constraintEnd_toStartOf="@+id/call_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

      <LinearLayout
          android:id="@+id/extra"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:visibility="invisible"
          android:orientation="horizontal"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/trav_card">

          <Button
              android:id="@+id/delete"
              android:layout_width="0dp"
              android:layout_marginStart="5dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:clickable="true"
              android:textSize="12dp"
              android:background="@drawable/rounded_storage"
              android:layout_weight="1"
              android:layout_marginEnd="5dp"
              android:layout_marginBottom="5dp"
              android:backgroundTint="#E82B60"
              android:contentDescription="@string/Delete"
                android:text="@string/Delete"
              android:textAllCaps="false"
              android:drawableRight="@drawable/delete_white"
/>

          <Button
              android:id="@+id/edit"
              android:layout_width="0dp"
              android:textSize="12dp"

              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginBottom="5dp"
              android:backgroundTint="#CEC4DA"
              android:layout_marginEnd="5dp"
              android:background="@drawable/rounded_storage"
              android:backgroundTintMode="src_over"
              android:contentDescription="@string/Edit"
              android:drawableRight="@drawable/rate"
              android:text="@string/Edit"
              android:layout_weight="1"

              android:textAllCaps="false"
 />

          <Button
              android:id="@+id/infos"
              android:layout_width="0dp"
              android:layout_marginEnd="5dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginBottom="5dp"
              android:layout_weight="1"
              android:textSize="12dp"
                android:textAllCaps="false"
              android:background="@drawable/rounded_storage"
              android:backgroundTint="@color/purple_200"
              android:backgroundTintMode="src_over"
              android:contentDescription="TODO"
              android:drawableRight="@drawable/more_info"
              android:text="@string/info"

              app:maxImageSize="60dp" />

      </LinearLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>